{# templates/tarefas/relatorio_display.html #}
{% extends "tarefas/base_tarefas.html" %}
{% load relatorio_tags %}

{% block title %}Resultado do Relatório{% endblock %}

{% block tarefas_content %}
<div class="rel-wrapper">

    <div class="rel-header">
        <div>
            <h1 class="rel-title"><i class="bi bi-file-earmark-text me-2"></i>Resultado do Relatório</h1>
            <p class="rel-subtitle">
                {{ total_tarefas|default:0 }} tarefa{{ total_tarefas|pluralize:"s" }} encontrada{{ total_tarefas|pluralize:"s" }}
            </p>
        </div>
        <div class="rel-actions">
            <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-printer me-1"></i><span class="d-none d-sm-inline">Imprimir</span>
            </button>
            <a href="{% url 'tarefas:gerar_relatorio' %}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-funnel me-1"></i><span class="d-none d-sm-inline">Novos Filtros</span>
            </a>
            <a href="{% url 'tarefas:relatorio_tarefas' %}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i><span class="d-none d-sm-inline">Relatórios</span>
            </a>
        </div>
    </div>

    {% include 'tarefas/partials/_filter_tags.html' %}

    <div class="rel-card">
        <div class="rel-card-header">
            <h6 class="rel-card-title"><i class="bi bi-table me-2"></i>Resultados</h6>
            <span class="rel-count">{{ total_tarefas|default:0 }}</span>
        </div>

        <form method="get" class="rel-filter-bar">
            {% if current_filters.status %}<input type="hidden" name="status" value="{{ current_filters.status }}">{% endif %}
            {% if current_filters.prioridade %}<input type="hidden" name="prioridade" value="{{ current_filters.prioridade }}">{% endif %}

            <label for="responsavel" class="rel-quick-export-label"><i class="bi bi-person me-1"></i>Responsável:</label>
            <select name="responsavel" id="responsavel" class="form-select form-select-sm rel-filter-select" onchange="this.form.submit()">
                <option value="">Todos os responsáveis</option>
                {% for u in responsaveis %}
                    <option value="{{ u.pk }}" {% if current_filters.responsavel == u.pk|stringformat:"d" %}selected{% endif %}>
                        {{ u.get_full_name|default:u.username }}
                    </option>
                {% endfor %}
            </select>

            {% if current_filters.responsavel %}
                <a href="?{% if current_filters.status %}status={{ current_filters.status }}&{% endif %}{% if current_filters.prioridade %}prioridade={{ current_filters.prioridade }}{% endif %}"
                   class="btn btn-sm btn-outline-danger" title="Limpar filtro de responsável">
                    <i class="bi bi-x-lg"></i>
                </a>
            {% endif %}
        </form>

        <div class="rel-table-scroll">
            <table class="rel-table">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Responsável</th>
                        <th>Status</th>
                        <th>Prioridade</th>
                        <th>Criação</th>
                        <th>Prazo</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tarefa in tarefas %}
                    <tr>
                        <td data-label="Título"><span class="rel-table-title">{{ tarefa.titulo }}</span></td>
                        <td data-label="Responsável">
                            {% if tarefa.responsavel %}{{ tarefa.responsavel.get_full_name|default:tarefa.responsavel.username }}{% else %}—{% endif %}
                        </td>
                        <td data-label="Status">
                            <span class="rel-badge" style="--badge-bg: {% status_color tarefa.status 'bg' %}; --badge-fg: {% status_color tarefa.status 'fg' %};">
                                {{ tarefa.get_status_display }}
                            </span>
                        </td>
                        <td data-label="Prioridade">
                            <span class="rel-badge" style="--badge-bg: {% priority_color tarefa.prioridade 'bg' %}; --badge-fg: {% priority_color tarefa.prioridade 'fg' %};">
                                {{ tarefa.get_prioridade_display }}
                            </span>
                        </td>
                        <td data-label="Criação">{{ tarefa.data_criacao|date:"d/m/Y" }}</td>
                        <td data-label="Prazo">{{ tarefa.prazo|date:"d/m/Y"|default:"—" }}</td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6">
                            <div class="rel-empty">
                                <i class="bi bi-inbox d-block mb-2"></i>
                                Nenhuma tarefa encontrada para os filtros selecionados.
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'tarefas/partials/_status_priority_analysis.html' %}
        {% include 'tarefas/partials/_quick_export.html' %}
    </div>
</div>
{% endblock %}


